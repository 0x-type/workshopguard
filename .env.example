# ---------------------------------------------------------------------------
# C01 prototype configuration. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# AI provider: deepseek (default) | mock (deterministic, offline)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=20000
# When a live call fails, fall back to the deterministic mock and say so on
# screen. Set to false to stop at "Manual review required" instead.
AI_FALLBACK=true

# --- Outbound email -------------------------------------------------------
# With EMAIL_ENABLED=false every send is clearly labelled SIMULATED and no
# network call is made. The demo works either way.
EMAIL_ENABLED=false
RESEND_API_KEY=
# The ONLY address this prototype is ever allowed to email. Any other
# recipient is refused before a network call is attempted.
DEMO_TEST_EMAIL=
# Must be on a domain verified in your Resend dashboard.
RESEND_FROM="Service Desk <service-desk@example.com>"

# --- Inbound email (optional) ---------------------------------------------
# Signing secret from the Resend webhook you create. Without it the inbound
# endpoint refuses every request, which is the safe default.
RESEND_WEBHOOK_SECRET=
